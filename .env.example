# =============================================================================
# CONFIGURAÇÃO DO PORTFÓLIO — MODELO
# =============================================================================
# Copie este arquivo para `.env` e preencha os valores.
#
#   cp .env.example .env
#
# Depois gere o arquivo de configuração que o navegador carrega:
#
#   node scripts/build-config.mjs
#
# `.env` está no .gitignore. `js/config.generated.js` também.
#
# -----------------------------------------------------------------------------
# ⚠️  LEIA ISTO ANTES DE COLOCAR QUALQUER SEGREDO AQUI
# -----------------------------------------------------------------------------
# Este site é 100% estático — não existe servidor. Tudo que entra em
# `js/config.generated.js` é baixado pelo navegador e fica visível em
# DevTools > Sources para qualquer visitante.
#
# Portanto, este arquivo só pode conter valores PÚBLICOS por natureza:
# identificadores de projeto, chaves publicáveis e URLs.
#
# Uma chave que dá acesso pago ou privilegiado (ElevenLabs, OpenAI, Gemini,
# tokens de banco de dados) NUNCA pode ficar aqui. Ela precisa viver em um
# proxy no servidor — veja ELEVENLABS_PROXY_URL abaixo.
# =============================================================================


# -----------------------------------------------------------------------------
# EmailJS — formulário de contato
# -----------------------------------------------------------------------------
# Estes valores são publicáveis POR DESIGN: o EmailJS funciona no navegador e
# espera que fiquem visíveis. A proteção correta não é escondê-los, e sim
# restringir os domínios autorizados no painel:
#   Account > Security > Allowlist  ->  adicione apenas o seu domínio
# Sem essa allowlist, qualquer pessoa pode usar sua cota de envios.

EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_OWNER=template_xxxxxxx
EMAILJS_TEMPLATE_CLIENT=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Text-to-Speech do chatbot
# -----------------------------------------------------------------------------
# Opção 1: Cole sua chave do ElevenLabs em ELEVENLABS_API_KEY.
# Opção 2: Publique uma função serverless e informe a URL em ELEVENLABS_PROXY_URL.
# Opção 3: Deixe ambos vazios para usar a Web Speech API gratuita do navegador.

ELEVENLABS_API_KEY=
ELEVENLABS_PROXY_URL=


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

SITE_URL=https://nansinyx26.github.io/Portifolio-2026-Renan-Farias/
CONTACT_EMAIL=oliversinyxcontato@gmail.com
